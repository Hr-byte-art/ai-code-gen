package com.wjh.aicodegen.monitor;

import jakarta.annotation.Resource;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.time.Duration;

/**
 * 简化的监控服务
 * 提供直接的监控方法，不依赖ThreadLocal
 * 
 * @author 王哈哈
 */
@Service
@Slf4j
public class SimpleMonitorService {

    @Resource
    private AiModelMetricsCollector aiModelMetricsCollector;

    /**
     * 记录AI模型请求
     */
    public void recordAiRequest(String userId, String appId, String modelName, String status) {
        try {
            aiModelMetricsCollector.recordRequest(userId, appId, modelName, status);
        } catch (Exception e) {
            log.warn("Failed to record AI request: {}", e.getMessage());
        }
    }

    /**
     * 记录模型调用次数
     */
    public void recordModelCall(String userId, String appId, String modelName) {
        try {
            aiModelMetricsCollector.recordModelCallCount(userId, appId, modelName);
        } catch (Exception e) {
            log.warn("Failed to record model call: {}", e.getMessage());
        }
    }

    /**
     * 记录响应时间
     */
    public void recordResponseTime(String userId, String appId, String modelName, Duration responseTime) {
        try {
            aiModelMetricsCollector.recordResponseTime(userId, appId, modelName, responseTime);
        } catch (Exception e) {
            log.warn("Failed to record response time: {}", e.getMessage());
        }
    }

    /**
     * 记录Token使用情况
     */
    public void recordTokenUsage(String userId, String appId, String modelName, String tokenType, Integer count) {
        try {
            aiModelMetricsCollector.recordTokenUsage(userId, appId, modelName, tokenType, count);
        } catch (Exception e) {
            log.warn("Failed to record token usage: {}", e.getMessage());
        }
    }

    /**
     * 记录错误
     */
    public void recordError(String userId, String appId, String modelName, String errorMessage) {
        try {
            aiModelMetricsCollector.recordError(userId, appId, modelName, errorMessage);
        } catch (Exception e) {
            log.warn("Failed to record error: {}", e.getMessage());
        }
    }
}
